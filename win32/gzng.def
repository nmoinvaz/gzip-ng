; gzip-ng block compression library
EXPORTS
; version
    gzng_version
    gzng_zlibng_version
; block writer
    gzblock_writer_open
    gzblock_writer_rsyncable
    gzblock_writer_meta
    gzblock_writer_write
    gzblock_writer_setparams
    gzblock_writer_flush
    gzblock_writer_finish
    gzblock_writer_error
    gzblock_writer_errcode
    gzblock_writer_close
; block reader
    gzblock_reader_open
    gzblock_reader_read
    gzblock_reader_next
    gzblock_reader_error
    gzblock_reader_errcode
    gzblock_reader_close
; streams
    gzng_compress_stream
    gzng_decompress_stream
